{
  "name": "feedlr",
  "scripts": {
    "build": "npm run build:vendor && npx @tailwindcss/cli -i tailwind.css -o assets/css/style.css",
    "build:vendor": "node scripts/build-vendor.mjs",
    "test": "node --test assets/js/feedlr-player.test.cjs assets/js/player-timeline.test.cjs assets/js/podcast-player.test.cjs",
    "dev": "npm run build:vendor && npx @tailwindcss/cli -i tailwind.css -o assets/css/style.css --watch"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "fuse.js": "7.5.0",
    "htmx-ext-head-support": "2.0.5",
    "htmx.org": "2.0.11",
    "hyperscript.org": "0.9.93",
    "shaka-player": "5.3.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}

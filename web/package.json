{
  "name": "feedlr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:biome && npm run lint:eslint && npm run lint:css",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:visual": "playwright test -c .storybook/playwright.config.ts",
    "api:generate": "openapi-typescript ../api/frontend.openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/frontend.openapi.json -o src/lib/api/schema.d.ts --check",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint:biome": "biome check . --error-on-warnings",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}

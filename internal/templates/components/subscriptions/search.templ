package subscriptions

import (
	"fmt"
	"net/url"

	"github.com/cufee/feedlr-yt/internal/api/rss"
	"github.com/cufee/feedlr-yt/internal/api/youtube"
	"github.com/cufee/feedlr-yt/internal/templates/components/channel"
	"github.com/cufee/feedlr-yt/internal/templates/components/ui"
	"github.com/cufee/feedlr-yt/internal/types"
)

type DiscoveryProps struct {
	SubscriptionSource     types.MediaSource
	PodcastSearchAvailable bool
}

templ Discovery(props DiscoveryProps) {
	<div class="glass-panel flex w-full flex-col gap-4 p-4 md:p-5">
		if props.SubscriptionSource == types.MediaSourcePodcasts {
			@SearchPodcasts(props.SubscriptionSource, props.PodcastSearchAvailable)
		} else {
			@SearchChannels(props.SubscriptionSource)
		}
	</div>
}

templ SearchChannels(source types.MediaSource) {
	<div id="youtube-search-shell" class="ui-search-shell">
		<div class="ui-search-box group" id="youtube-search-box">
			<input type="search" placeholder="Search YouTube channels" name="search" minlength="3" maxlength="32" _="on clear send clear to #youtube-search-results on load set my value to '' then" class="ui-input w-full" hx-get={ "/api/channels/search?source=" + string(source) } hx-target="#youtube-search-results" hx-swap="innerHTML" hx-trigger="keyup changed delay:750ms" hx-sync="this:replace" id="youtube-search-input"/>
		</div>
		<div id="youtube-search-results" class="ui-search-results empty:hidden"></div>
	</div>
}

templ SearchResultChannels(channels []types.ChannelSearchResultProps) {
	for _, ch := range channels {
		<div class="ui-motion-swap ui-channel-card group channel-btn" id={ fmt.Sprintf("channel-tile-%s", ch.ID) }>
			@ui.Badge("YouTube", ui.BadgeNeutral, "ui-source-badge ui-source-badge-channel")
			<a hx-boost="true" href={ templ.URL(fmt.Sprintf("/channel/%s", ch.ID)) } class="ui-channel-overlay md:group-hover:opacity-100 group-[.htmx-request]:opacity-100" hx-indicator={ fmt.Sprintf("#channel-tile-%s", ch.ID) }>
				<span class="ui-spinner size-6 border-[3px] md:size-7 htmx-indicator ui-indicator-delayed"></span>
				<span class="group-[.htmx-request]:hidden">Open</span>
			</a>
			@channel.ChannelTile(ch.Channel, ch.Thumbnail, nil)
		</div>
	}
}

templ SearchPodcasts(source types.MediaSource, available bool) {
	<div class="ui-search-shell">
		if available {
			<div class="ui-search-box group">
				<input type="search" placeholder="Search podcast catalog" name="search" minlength="3" maxlength="100" _="on clear send clear to #podcast-search-results on load set my value to '' then" class="ui-input w-full" hx-get={ "/api/podcasts/search?source=" + string(source) } hx-target="#podcast-search-results" hx-swap="innerHTML" hx-trigger="keyup changed delay:750ms" hx-sync="this:replace" id="podcast-search-input"/>
			</div>
		} else {
			@ui.Toast("Podcast catalog search is unavailable. You can still subscribe with an RSS feed URL.", ui.ToastInfo)
		}
		<form class="flex flex-col gap-2 sm:flex-row" hx-post={ "/api/podcasts/subscribe?type=manual&source=" + string(source) } hx-target="#podcast-subscribe-feedback" hx-swap="innerHTML" hx-sync="this:replace">
			<input type="url" name="feed_url" placeholder="https://example.com/podcast.xml" class="ui-input w-full" required/>
			<button type="submit" class="ui-btn ui-btn-neutral shrink-0">Add RSS feed</button>
		</form>
		<div id="podcast-subscribe-feedback" class="empty:hidden"></div>
		<div id="podcast-search-results" class="ui-search-results empty:hidden"></div>
	</div>
}

templ SearchResultPodcasts(podcasts []types.PodcastSearchResultProps) {
	for _, podcast := range podcasts {
		<div class="podcast-search-result ui-motion-swap ui-channel-card group" id={ podcastSearchResultID(podcast) }>
			@ui.Badge("Podcast", ui.BadgeNeutral, "ui-source-badge ui-source-badge-channel")
			<a hx-boost="true" href={ templ.URL(podcastOpenURL(podcast.FeedURL)) } class="ui-channel-overlay md:group-hover:opacity-100 group-[.htmx-request]:opacity-100" hx-indicator={ "#" + podcastSearchResultID(podcast) }>
				<span class="ui-spinner size-6 border-[3px] md:size-7 htmx-indicator ui-indicator-delayed"></span>
				<span class="group-[.htmx-request]:hidden">Open</span>
			</a>
			@channel.ChannelTile(youtube.Channel{Title: podcast.Title, Description: podcastSearchDescription(podcast)}, podcast.ArtworkURL, nil)
		</div>
	}
}

func podcastSearchDescription(podcast types.PodcastSearchResultProps) string {
	if podcast.Author == "" {
		return podcast.Description
	}
	if podcast.EpisodeCount == 0 {
		return podcast.Author
	}
	return fmt.Sprintf("%s · %d episodes", podcast.Author, podcast.EpisodeCount)
}

func podcastOpenURL(feedURL string) string {
	return "/api/podcasts/open?feed_url=" + url.QueryEscape(feedURL)
}

func podcastSearchResultID(podcast types.PodcastSearchResultProps) string {
	return "podcast-search-result-" + rss.ShowID(podcast.FeedURL)
}

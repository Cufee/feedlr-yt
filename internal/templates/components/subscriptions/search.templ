package subscriptions

import (
	"fmt"
	"net/url"

	"github.com/cufee/feedlr-yt/internal/templates/components/channel"
	"github.com/cufee/feedlr-yt/internal/templates/components/ui"
	"github.com/cufee/feedlr-yt/internal/types"
)

type DiscoveryProps struct {
	SubscriptionSource     types.MediaSource
	DiscoverySource        types.MediaSource
	PodcastSearchAvailable bool
	YouTubeURL             string
	PodcastsURL            string
}

templ Discovery(props DiscoveryProps) {
	<div class="glass-panel flex w-full flex-col gap-4 p-4 md:p-5">
		<div class="ui-filter-tabs-wrap">
			<div class="ui-tabs" aria-label="Subscription discovery source">
				@discoveryTab(props.YouTubeURL, props.DiscoverySource == types.MediaSourceYouTube, "YouTube")
				@discoveryTab(props.PodcastsURL, props.DiscoverySource == types.MediaSourcePodcasts, "Podcasts")
			</div>
		</div>
		if props.DiscoverySource == types.MediaSourcePodcasts {
			@SearchPodcasts(props.SubscriptionSource, props.PodcastSearchAvailable)
		} else {
			@SearchChannels(props.SubscriptionSource)
		}
	</div>
}

templ discoveryTab(url string, active bool, label string) {
	<a class={ "ui-tab", templ.KV("ui-tab-active", active) } href={ templ.URL(url) } hx-boost="true" hx-target="body">
		{ label }
	</a>
}

templ SearchChannels(source types.MediaSource) {
	<div id="youtube-search-shell" class="ui-search-shell">
		<div class="ui-search-box group" id="youtube-search-box">
			<input type="search" placeholder="Search YouTube channels" name="search" minlength="3" maxlength="32" _="on clear send clear to #youtube-search-results on load set my value to '' then" class="ui-input w-full" hx-get={ "/api/channels/search?source=" + string(source) } hx-target="#youtube-search-results" hx-swap="innerHTML" hx-trigger="keyup changed delay:750ms" hx-sync="this:replace" id="youtube-search-input"/>
		</div>
		<div id="youtube-search-results" class="ui-search-results empty:hidden"></div>
	</div>
}

templ SearchResultChannels(channels []types.ChannelSearchResultProps, source types.MediaSource) {
	for _, ch := range channels {
		<div class="ui-motion-swap ui-channel-card group channel-btn" id={ fmt.Sprintf("channel-tile-%s", ch.ID) }>
			@ui.Badge("YouTube", ui.BadgeNeutral, "ui-source-badge absolute left-2 top-2 z-20")
			<a hx-boost="true" href={ templ.URL(fmt.Sprintf("/channel/%s", ch.ID)) } class="ui-channel-overlay md:group-hover:opacity-100 group-[.htmx-request]:opacity-100" hx-indicator={ fmt.Sprintf("#channel-tile-%s", ch.ID) }>
				<span class="ui-spinner size-6 border-[3px] md:size-7 htmx-indicator ui-indicator-delayed"></span>
				<span class="group-[.htmx-request]:hidden">Open</span>
			</a>
			@channel.ChannelTile(ch.Channel, ch.Thumbnail, YouTubeSearchAction(ch.ID, ch.Subscribed, source))
		</div>
	}
}

templ YouTubeSearchAction(channelID string, subscribed bool, source types.MediaSource) {
	<div id={ fmt.Sprintf("channel-search-action-%s", channelID) } class="relative z-20">
		if subscribed {
			<button type="button" class="ui-btn ui-btn-neutral ui-btn-sm" title="Unsubscribe" hx-post={ fmt.Sprintf("/api/channels/%s/unsubscribe?type=search&source=%s", channelID, source) } hx-target={ fmt.Sprintf("#channel-search-action-%s", channelID) } hx-swap="outerHTML">
				Unsubscribe
			</button>
		} else {
			<button type="button" class="ui-btn ui-btn-primary ui-btn-sm" title="Subscribe" hx-post={ fmt.Sprintf("/api/channels/%s/subscribe?type=search&source=%s", channelID, source) } hx-target={ fmt.Sprintf("#channel-search-action-%s", channelID) } hx-swap="outerHTML">
				Subscribe
			</button>
		}
	</div>
}

templ SearchPodcasts(source types.MediaSource, available bool) {
	<div class="ui-search-shell">
		if available {
			<div class="ui-search-box group">
				<input type="search" placeholder="Search podcast catalog" name="search" minlength="3" maxlength="100" _="on clear send clear to #podcast-search-results on load set my value to '' then" class="ui-input w-full" hx-get={ "/api/podcasts/search?source=" + string(source) } hx-target="#podcast-search-results" hx-swap="innerHTML" hx-trigger="keyup changed delay:750ms" hx-sync="this:replace" id="podcast-search-input"/>
			</div>
		} else {
			@ui.Toast("Podcast catalog search is unavailable. You can still subscribe with an RSS feed URL.", ui.ToastInfo)
		}
		<form class="flex flex-col gap-2 sm:flex-row" hx-post={ "/api/podcasts/subscribe?type=manual&source=" + string(source) } hx-target="#podcast-subscribe-feedback" hx-swap="innerHTML" hx-sync="this:replace">
			<input type="url" name="feed_url" placeholder="https://example.com/podcast.xml" class="ui-input w-full" required/>
			<button type="submit" class="ui-btn ui-btn-neutral shrink-0">Add RSS feed</button>
		</form>
		<div id="podcast-subscribe-feedback" class="empty:hidden"></div>
		<div id="podcast-search-results" class="ui-search-results empty:hidden"></div>
	</div>
}

templ SearchResultPodcasts(podcasts []types.PodcastSearchResultProps, source types.MediaSource) {
	for _, podcast := range podcasts {
		<div class="podcast-search-result ui-motion-swap ui-channel-card group">
			@ui.Badge("Podcast", ui.BadgeAccent, "ui-source-badge absolute left-2 top-2 z-20")
			<div class="ui-channel-tile">
				<div class="ui-channel-thumb">
					<div class="ui-channel-thumb-skeleton"></div>
					if podcast.ArtworkURL != "" {
						<img class="relative z-10 h-full w-full object-cover" src={ templ.URL(podcast.ArtworkURL) } alt={ podcast.Title } loading="lazy" decoding="async"/>
					}
				</div>
				<div class="flex min-h-[5.3rem] w-full flex-col justify-start">
					<div class="flex items-start justify-between gap-2">
						<div class="my-auto ui-channel-title">{ podcast.Title }</div>
						@PodcastSearchAction(podcast.FeedURL, podcast.Subscribed, source)
					</div>
					<span class="ui-channel-description">
						if podcast.Author != "" {
							{ podcast.Author }
							if podcast.EpisodeCount > 0 {
								{ fmt.Sprintf(" · %d episodes", podcast.EpisodeCount) }
							}
						} else if podcast.Description != "" {
							{ podcast.Description }
						}
					</span>
				</div>
			</div>
		</div>
	}
}

templ PodcastSearchAction(feedURL string, subscribed bool, source types.MediaSource) {
	<div class="podcast-search-action relative z-20">
		if subscribed {
			@ui.Badge("Subscribed", ui.BadgeAccent, "")
		} else {
			<button type="button" class="ui-btn ui-btn-primary ui-btn-sm" title="Subscribe" hx-post={ podcastSubscribeURL(feedURL, source) } hx-target="closest .podcast-search-action" hx-swap="outerHTML">
				Subscribe
			</button>
		}
	</div>
}

func podcastSubscribeURL(feedURL string, source types.MediaSource) string {
	return "/api/podcasts/subscribe?type=search&source=" + string(source) + "&feed_url=" + url.QueryEscape(feedURL)
}

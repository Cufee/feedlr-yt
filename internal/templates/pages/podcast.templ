package pages

import (
	"fmt"

	"github.com/cufee/feedlr-yt/internal/templates/components/feed"
	"github.com/cufee/feedlr-yt/internal/templates/components/shared"
	"github.com/cufee/feedlr-yt/internal/types"
)

templ Podcast(props types.VideoPlayerProps) {
	<div class="relative flex min-h-0 grow flex-col">
		<div class="ui-podcast-rail">
			<div class="ui-video-rail-actions">
				@buttonChannel(props.Video.Channel.ID)
				@buttonShare(props.Video.ID)
				if props.Authenticated {
					@feed.WatchLaterButton(props.Video.ID, props.Video.InWatchLater, feed.WatchLaterVideo)
					if len(props.UserPlaylists) > 0 {
						@shared.AddToPlaylistSelect(props.Video.ID, props.UserPlaylists, props.VideoInPlaylistIDs)
					}
				}
			</div>
			<div class="ui-video-rail-actions">
				if props.Authenticated {
					@buttonBack(props.ReturnURL)
				} else {
					@buttonLogin()
				}
			</div>
		</div>
		@podcastPlayer(props)
	</div>
}

templ podcastPlayer(player types.VideoPlayerProps) {
	<main id="podcast-player-page" class="podcast-player-page">
		<section class="podcast-player-surface w-full" aria-label="Podcast player">
			<div class="podcast-player-details">
				<div class="podcast-player-artwork-stage">
					<img
						src={ templ.URL(fmt.Sprintf("/thumb/video/%s/sddefault", player.Video.ID)) }
						alt={ player.Video.Title }
						class="podcast-player-artwork"
					/>
				</div>
				<div class="podcast-player-identity">
					<h1 class="podcast-player-title">{ player.Video.Title }</h1>
					<a href={ templ.URL(fmt.Sprintf("/channel/%s", player.Video.Channel.ID)) } class="mt-2 inline-block text-sm text-text-secondary transition-colors hover:text-text-primary">
						{ player.Video.Channel.Title }
					</a>
				</div>
			</div>
			<div class="podcast-player-secondary">
				<section class="podcast-player-notes" aria-label="Episode details">
					<div class="ui-tabs grid w-full grid-cols-2" role="tablist" aria-label="Episode details">
						<button id="podcast-notes-tab" type="button" class="ui-tab h-full w-full ui-tab-active" role="tab" aria-selected="true" aria-controls="podcast-notes-panel">Episode notes</button>
						<button id="podcast-segments-tab" type="button" class="ui-tab h-full w-full" role="tab" aria-selected="false" aria-controls="podcast-segments-panel" hidden><span>Episode segments</span><span data-podcast-segment-count class="ui-badge hidden"></span><span data-podcast-segment-spinner class="ui-spinner size-3 border-2"></span></button>
					</div>
					<div id="podcast-notes-panel" class="podcast-player-notes-content" role="tabpanel" aria-labelledby="podcast-notes-tab">
							@shared.PodcastHTML(player.Video.Description)
						</div>
					<div id="podcast-segments-panel" class="podcast-player-notes-content hidden" role="tabpanel" aria-labelledby="podcast-segments-tab"></div>
				</section>
				<div class="podcast-player-controls">
					<audio id="podcast-player" data-feedlr-podcast-player autoplay preload="metadata" src={ templ.URL(player.Video.StreamURL) }></audio>
					<div class="podcast-player-timeline">
						<div class="relative">
							<div id="podcast-segment-markers" class="pointer-events-none absolute inset-x-0 top-1/2 z-30 h-1 -translate-y-1/2" aria-hidden="true"></div>
							<input id="podcast-progress" class="podcast-player-scrubber relative z-20" type="range" min="0" max="0" value="0" step="1" aria-label="Episode progress" aria-valuetext="0 minutes 0 seconds of 0 minutes 0 seconds"/>
						</div>
						<div class="flex items-center justify-between text-xs tabular-nums text-text-secondary">
							<output id="podcast-elapsed">0:00</output>
							<output id="podcast-remaining">-0:00</output>
						</div>
					</div>
					<div class="podcast-player-transport" aria-label="Playback controls">
						<button type="button" data-podcast-skip="-15" class="podcast-player-skip" aria-label="Skip back 15 seconds"><span>15</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg></button>
						<button type="button" id="podcast-play-toggle" class="podcast-player-play" aria-label="Loading episode" aria-busy="true" disabled>
							<span data-podcast-loading-icon class="ui-spinner size-6" aria-hidden="true"></span>
							<svg data-podcast-play-icon class="hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z"></path></svg>
							<svg data-podcast-pause-icon class="hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7V5Zm7 0h3v14h-3V5Z"></path></svg>
						</button>
						<button type="button" data-podcast-skip="15" class="podcast-player-skip" aria-label="Skip forward 15 seconds"><span>15</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
					</div>
					<div class="podcast-player-options">
						<label class="podcast-player-select-label" for="podcast-speed">Speed</label>
						<select id="podcast-speed" class="podcast-player-select" aria-label="Playback speed">
							for _, rate := range []string{"0.75", "1", "1.25", "1.5", "1.75", "2"} {
								<option value={ rate }>{ rate + "x" }</option>
							}
						</select>
						<label class="podcast-player-volume" for="podcast-volume"><span>Volume</span><input id="podcast-volume" type="range" min="0" max="100" value="100" aria-label="Volume"/></label>
					</div>
				</div>
			</div>
		</section>
	</main>
	@shared.EmbedScript(podcastPlayerInit(player.Video.ID, player.Video.Title, player.Video.Channel.Title, player.Video.Progress, player.ReportProgress, player.PodcastSegments), player.Video.ID, player.Video.Title, player.Video.Channel.Title, player.Video.Progress, player.ReportProgress, player.PodcastSegments)
}

script podcastPlayerInit(episode, title, channel string, progress int, withProgress bool, initialSegments any) {
	const root = document.getElementById("podcast-player-page")
	const audio = document.getElementById("podcast-player")
	if (!root || !audio) return

	window.feedlrPodcastPlayer?.cleanup?.()
	for (const player of document.querySelectorAll("audio[data-feedlr-podcast-player]")) {
		if (player !== audio) {
			player.pause()
			player.removeAttribute("src")
			player.load()
		}
	}

	const controller = new AbortController()
	let lastProgress = -1
	let progressTimer
	let disposed = false
	let loading = true
	let segments = initialSegments?.segments || []
	let analysisStatus = initialSegments?.status || "pending"
	let lastSkippedSegmentID = ""
	let manuallyEnteredSegmentID = ""
	let pollTimer
	let progressInput
	const segmentTab = root.querySelector("#podcast-segments-tab")
	const notesTab = root.querySelector("#podcast-notes-tab")
	const notesPanel = root.querySelector("#podcast-notes-panel")
	const segmentsPanel = root.querySelector("#podcast-segments-panel")
	const segmentCount = root.querySelector("[data-podcast-segment-count]")
	const segmentSpinner = root.querySelector("[data-podcast-segment-spinner]")
	const segmentMarkers = root.querySelector("#podcast-segment-markers")
	function element(tag, className, value) { const node = document.createElement(tag); if (className) node.className = className; if (value) node.textContent = value; return node }
	function updateSegmentTrack() {
		if (!progressInput) return
		const duration = Number.isFinite(audio.duration) ? audio.duration : 0
		const ranges = duration > 0 ? segments.filter((segment) => segment.skippable).map((segment) => ({ start: Math.max(0, Math.min(100, segment.start_ms / 1000 / duration * 100)), end: Math.max(0, Math.min(100, segment.end_ms / 1000 / duration * 100)) })).filter((range) => range.end > range.start).sort((a, b) => a.start - b.start) : []
		segmentMarkers.replaceChildren()
		for (const range of ranges) { const marker = document.createElement("span"); marker.className = "absolute h-full rounded-full bg-accent/80"; marker.style.left = `${range.start}%`; marker.style.width = `${range.end - range.start}%`; segmentMarkers.append(marker) }
	}
	function setActivePanel(panel) {
		const notesActive = panel === "notes"
		notesPanel.classList.toggle("hidden", !notesActive)
		segmentsPanel.classList.toggle("hidden", notesActive)
		notesTab.classList.toggle("ui-tab-active", notesActive)
		segmentTab.classList.toggle("ui-tab-active", !notesActive)
		notesTab.setAttribute("aria-selected", String(notesActive))
		segmentTab.setAttribute("aria-selected", String(!notesActive))
	}
	function panelMessage(message, pending) {
		const messagePanel = element("div", "glass-panel flex items-center gap-3 p-4 text-sm text-text-secondary")
		if (pending) messagePanel.append(element("span", "ui-spinner size-4 border-2"))
		messagePanel.append(element("span", "", message))
		segmentsPanel.replaceChildren(messagePanel)
	}
	function renderSegments() {
		updateSegmentTrack()
		segmentTab.hidden = false
		const complete = analysisStatus === "ready" || analysisStatus === "failed" || analysisStatus === "unavailable"
		segmentSpinner.classList.toggle("hidden", complete)
		segmentCount.classList.toggle("hidden", !complete)
		if (!complete) { panelMessage("Finding episode segments…", false); return }
		segmentCount.textContent = String(segments.length)
		segmentsPanel.replaceChildren()
		if (!segments.length) { panelMessage("No selected episode segments identified.", false); return }
		const list = element("div", "flex flex-col gap-2")
		for (const segment of segments) {
			const row = element("div", "glass-panel w-full p-3")
			const header = element("div", "flex items-center justify-between gap-3")
			const labels = element("div", "flex min-w-0 items-center gap-2")
			labels.append(element("span", "ui-badge ui-badge-accent capitalize", segment.category))
			header.append(labels)
			const duration = Math.max(0, Math.round((segment.end_ms - segment.start_ms) / 1000))
			header.append(element("span", "shrink-0 text-xs tabular-nums text-text-secondary", `${formatTime(segment.start_ms/1000)}–${formatTime(segment.end_ms/1000)} · ${duration}s`))
			row.append(header)
			row.append(element("p", "mt-2 line-clamp-2 text-sm leading-5 text-text-secondary", `${segment.start_text}${segment.end_text !== segment.start_text ? " … "+segment.end_text : ""}`))
			list.append(row)
		}
		segmentsPanel.append(list)
	}
	function applyStatus(payload) { analysisStatus=payload.status; segments=payload.segments||[]; renderSegments(); if (analysisStatus === "ready" || analysisStatus === "failed" || analysisStatus === "unavailable") { if (pollTimer) clearTimeout(pollTimer); if (analysisStatus === "ready") skipSegmentAtCurrentTime() } }
	async function loadSegmentStatus(waitMS) { try { const response=await fetch(`/api/videos/${episode}/sponsor-segments?wait_ms=${waitMS}`,{credentials:"include",signal:controller.signal}); if (!response.ok) return; const payload=await response.json(); applyStatus(payload); if (payload.status === "pending" || payload.status === "running") pollTimer=window.setTimeout(() => loadSegmentStatus(0),payload.poll_after_ms||2000) } catch (e) { if (e.name !== "AbortError") return } }
	notesTab?.addEventListener("click",()=>setActivePanel("notes"),{signal:controller.signal})
	segmentTab?.addEventListener("click",()=>setActivePanel("segments"),{signal:controller.signal})
	renderSegments()
	if (analysisStatus === "pending" || analysisStatus === "running") loadSegmentStatus(3000)

	function saveProgress() {
		if (!withProgress || disposed) return
		const currentTime = Math.floor(audio.currentTime)
		if (currentTime <= 0 || currentTime === lastProgress) return
		lastProgress = currentTime
		fetch(`/api/videos/${episode}/progress?progress=${currentTime}`, {
			method: "POST",
			credentials: "include",
			keepalive: true,
		}).catch(() => {})
	}

	function cleanup() {
		if (disposed) return
		saveProgress()
		disposed = true
		if (progressTimer) window.clearInterval(progressTimer)
		if (pollTimer) window.clearTimeout(pollTimer)
		controller.abort()
		audio.pause()
		audio.removeAttribute("src")
		audio.load()
		if (window.feedlrPodcastPlayer?.audio === audio) delete window.feedlrPodcastPlayer
	}

	window.feedlrPodcastPlayer = { audio, cleanup }
	if (!window.feedlrPodcastNavigationCleanup) {
		window.feedlrPodcastNavigationCleanup = true
		document.addEventListener("htmx:beforeSwap", (event) => {
			const player = window.feedlrPodcastPlayer
			if (player && event.detail.target?.contains(player.audio)) player.cleanup()
		})
		window.addEventListener("popstate", () => window.feedlrPodcastPlayer?.cleanup())
		window.addEventListener("pagehide", () => window.feedlrPodcastPlayer?.cleanup())
	}

	function seek(seconds) {
		const duration = Number.isFinite(audio.duration) ? audio.duration : Infinity
		setManualPosition(Math.max(0, Math.min(duration, audio.currentTime + seconds)))
	}
	if ("mediaSession" in navigator && "MediaMetadata" in window) {
		try {
			navigator.mediaSession.metadata = new MediaMetadata({
				title,
				artist: channel,
				album: channel,
				artwork: [{ src: new URL(`/thumb/video/${episode}/maxresdefault`, window.location.origin).href }],
			})
			navigator.mediaSession.setActionHandler("seekbackward", () => seek(-15))
			navigator.mediaSession.setActionHandler("seekforward", () => seek(15))
		} catch (_) {}
	}
	function formatTime(seconds) {
		const value = Math.max(0, Math.floor(Number.isFinite(seconds) ? seconds : 0))
		const hours = Math.floor(value / 3600)
		const minutes = Math.floor(value / 60) % 60
		const secs = value % 60
		return hours > 0 ? `${hours}:${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}` : `${minutes}:${String(secs).padStart(2, "0")}`
	}
	progressInput = root.querySelector("#podcast-progress")
	const elapsed = root.querySelector("#podcast-elapsed")
	const remaining = root.querySelector("#podcast-remaining")
	function updateTimeline() {
		const duration = Number.isFinite(audio.duration) ? audio.duration : 0
		progressInput.max = String(duration)
		progressInput.value = String(Math.min(audio.currentTime, duration))
		progressInput.setAttribute("aria-valuetext", `${formatTime(audio.currentTime)} of ${formatTime(duration)}`)
		elapsed.textContent = formatTime(audio.currentTime)
		remaining.textContent = `-${formatTime(duration - audio.currentTime)}`
		updateSegmentTrack()
	}
	function segmentID(segment) { return `${segment.start_ms}:${segment.end_ms}` }
	function segmentAt(time) { return segments.find((segment) => segment.skippable && time >= segment.start_ms / 1000 && time < segment.end_ms / 1000) }
	function setManualPosition(time) {
		const segment = segmentAt(time)
		manuallyEnteredSegmentID = segment ? segmentID(segment) : ""
		lastSkippedSegmentID = ""
		audio.currentTime = time
		updateTimeline()
	}
	function skipSegmentAtCurrentTime() {
		const segment = segmentAt(audio.currentTime)
		if (!segment) {
			manuallyEnteredSegmentID = ""
			return
		}
		const id = segmentID(segment)
		if (id === manuallyEnteredSegmentID || id === lastSkippedSegmentID) return
		lastSkippedSegmentID = id
		audio.currentTime = segment.end_ms / 1000
		updateTimeline()
		saveProgress()
	}
	const playToggle = root.querySelector("#podcast-play-toggle")
	const loadingIcon = root.querySelector("[data-podcast-loading-icon]")
	function setLoading(value) {
		loading = value
		playToggle.disabled = value
		playToggle.setAttribute("aria-busy", String(value))
		loadingIcon.classList.toggle("hidden", !value)
		if (value) {
			root.querySelector("[data-podcast-play-icon]").classList.add("hidden")
			root.querySelector("[data-podcast-pause-icon]").classList.add("hidden")
			playToggle.setAttribute("aria-label", "Loading episode")
			return
		}
		updatePlayButton()
	}
	function updatePlayButton() {
		if (loading) return
		const playing = !audio.paused && !audio.ended
		root.querySelector("[data-podcast-play-icon]").classList.toggle("hidden", playing)
		root.querySelector("[data-podcast-pause-icon]").classList.toggle("hidden", !playing)
		playToggle.setAttribute("aria-label", playing ? "Pause episode" : "Play episode")
	}

	function restoreProgress() {
		if (progress > 0 && Number.isFinite(audio.duration)) audio.currentTime = Math.min(progress, audio.duration)
		updateTimeline()
		skipSegmentAtCurrentTime()
	}
	if (audio.readyState >= HTMLMediaElement.HAVE_METADATA) restoreProgress()
	else audio.addEventListener("loadedmetadata", restoreProgress, { once: true, signal: controller.signal })

	const savedVolume = Number.parseInt(window.localStorage.getItem("player-volume"), 10)
	if (Number.isInteger(savedVolume) && savedVolume >= 0) audio.volume = savedVolume / 100
	const savedRate = Number.parseFloat(window.localStorage.getItem("podcast-playback-rate"))
	if (savedRate > 0) audio.playbackRate = savedRate

	const speedSelect = root.querySelector("#podcast-speed")
	speedSelect.value = String(audio.playbackRate)
	speedSelect.addEventListener("change", () => {
		audio.playbackRate = Number.parseFloat(speedSelect.value)
		window.localStorage.setItem("podcast-playback-rate", speedSelect.value)
	}, { signal: controller.signal })
	const volumeInput = root.querySelector("#podcast-volume")
	volumeInput.value = String(Math.round(audio.volume * 100))
	volumeInput.addEventListener("input", () => { audio.volume = Number(volumeInput.value) / 100 }, { signal: controller.signal })
	playToggle.addEventListener("click", () => {
		if (audio.paused) audio.play()
		else audio.pause()
	}, { signal: controller.signal })
	root.querySelectorAll("[data-podcast-skip]").forEach((button) => {
		button.addEventListener("click", () => seek(Number.parseInt(button.dataset.podcastSkip, 10)), { signal: controller.signal })
	})
	progressInput.addEventListener("input", () => {
		setManualPosition(Number(progressInput.value))
	}, { signal: controller.signal })
	audio.addEventListener("loadedmetadata", updateTimeline, { signal: controller.signal })
	audio.addEventListener("loadstart", () => setLoading(true), { signal: controller.signal })
	audio.addEventListener("canplay", () => setLoading(false), { signal: controller.signal })
	audio.addEventListener("error", () => setLoading(false), { signal: controller.signal })
	audio.addEventListener("timeupdate", () => { updateTimeline(); skipSegmentAtCurrentTime() }, { signal: controller.signal })
	audio.addEventListener("play", updatePlayButton, { signal: controller.signal })
	audio.addEventListener("pause", updatePlayButton, { signal: controller.signal })
	audio.addEventListener("ended", updatePlayButton, { signal: controller.signal })
	audio.addEventListener("volumechange", () => {
		volumeInput.value = String(Math.round(audio.volume * 100))
		window.localStorage.setItem("player-volume", Math.round(audio.volume * 100))
	}, { signal: controller.signal })
	audio.addEventListener("pause", saveProgress, { signal: controller.signal })
	audio.addEventListener("ended", saveProgress, { signal: controller.signal })
	document.getElementById("close-button")?.addEventListener("click", cleanup, { signal: controller.signal })
	document.addEventListener("keydown", (event) => {
		const target = event.target instanceof Element ? event.target : null
		if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || target?.closest("input, textarea, select, button, a, [contenteditable=true]")) return
		if (event.key === " ") {
			event.preventDefault()
			if (audio.paused) audio.play()
			else audio.pause()
		} else if (event.key === "ArrowLeft") {
			event.preventDefault()
			seek(-15)
		} else if (event.key === "ArrowRight") {
			event.preventDefault()
			seek(15)
		}
	}, { signal: controller.signal })
	if (withProgress) progressTimer = window.setInterval(saveProgress, 10000)
	updateTimeline()
	setLoading(loading)
}

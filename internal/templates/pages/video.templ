package pages

import (
	"fmt"
	"github.com/cufee/feedlr-yt/internal/templates/components/feed"
	"github.com/cufee/feedlr-yt/internal/templates/components/icons"
	"github.com/cufee/feedlr-yt/internal/templates/components/shared"
	"github.com/cufee/feedlr-yt/internal/templates/components/ui"
	"github.com/cufee/feedlr-yt/internal/types"
	"time"
)

var _ = types.PlaylistProps{}

func durationToString(videoDuration int) string {
	if videoDuration <= 0 {
		return ""
	}
	duration := time.Duration(videoDuration) * time.Second
	hours := int(duration.Hours())
	minutes := int(duration.Minutes()) % 60
	if hours > 0 {
		return fmt.Sprintf("%dh %dm", hours, minutes)
	}
	return fmt.Sprintf("%dm", minutes)
}

templ Video(props types.VideoPlayerProps) {
	<div class="feedlr-video-page relative flex grow flex-col">
		<div class="ui-video-rail">
			@playerActions(props)
			<div class="ui-video-rail-actions">
				if (props.Authenticated) {
					@buttonBack(props.ReturnURL)
				} else {
					@buttonLogin()
				}
			</div>
		</div>
		<div class="grow w-full flex flex-col relative">
			<div class="feedlr-player-loading" id="player-loading" role="status" aria-label="Loading video">
				<div class="feedlr-player-spinner" aria-hidden="true">
					<svg focusable="false" stroke="currentColor" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" width="50px" height="50px">
						<g transform="translate(1 1)" stroke-width="6" fill="none" fill-rule="evenodd">
							<circle stroke-opacity=".5" cx="18" cy="18" r="16"></circle>
							<path d="M34 18c0-9.94-8.06-16-16-16">
								<animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"></animateTransform>
							</path>
						</g>
					</svg>
				</div>
			</div>
			@videoPlayer(props)
		</div>
		<div id="notification-toast" class="opacity-0 pointer-events-none" role="status" aria-live="polite">
			@notificationToast("SponsorBlock skipped a video segment")
		</div>
	</div>
}

templ playerActions(props types.VideoPlayerProps) {
	<div id="player-actions" class="ui-video-rail-actions relative">
		@buttonChannel(props.Video.Channel.ID)
		if props.Authenticated {
			if props.Video.InWatchLater {
				@feed.WatchLaterButton(props.Video.ID, true, feed.WatchLaterVideo)
			}
			if len(props.UserPlaylists) > 0 && shared.AnyInPlaylist(props.VideoInPlaylistIDs) {
				@shared.AddToPlaylistSelect(props.Video.ID, props.UserPlaylists, props.VideoInPlaylistIDs)
			}
		}
		@playerActionMenu(props)
	</div>
	@shared.EmbedScript(playerActionsInit())
}

func playerActionMenu(props types.VideoPlayerProps) templ.Component {
	var actions []templ.Component
	if props.Authenticated {
		if !props.Video.InWatchLater {
			actions = append(actions, feed.WatchLaterButton(props.Video.ID, false, feed.WatchLaterVideo))
		}
		if len(props.UserPlaylists) > 0 && !shared.AnyInPlaylist(props.VideoInPlaylistIDs) {
			actions = append(actions, shared.AddToPlaylistSelect(props.Video.ID, props.UserPlaylists, props.VideoInPlaylistIDs))
		}
	}
	actions = append(actions, buttonShare(props.Video.ID))
	if props.Authenticated && !props.Video.IsPodcast() {
		actions = append(actions, buttonTV())
	}
	return ui.ActionMenu(actions...)
}

script playerActionsInit() {
	const root = document.getElementById("player-actions")
	root.addEventListener("htmx:afterSettle", (event) => {
		const action = event.detail.elt
		if (!action.matches("[data-player-action]")) return
		const menu = root.querySelector(".ui-action-menu")
		const panel = menu.querySelector(".ui-action-menu-panel")
		const active = action.dataset.active === "true"
		if (active) {
			const next = action.dataset.playerAction === "pin" ? root.querySelector(':scope > [data-player-action="playlist"]') : null
			root.insertBefore(action, next || menu)
		} else {
			const next = action.dataset.playerAction === "pin" ? panel.querySelector('[data-player-action="playlist"]') : null
			panel.insertBefore(action, next || panel.querySelector("#share-video-link-btn"))
		}
		menu.open = false
		const focusTarget = active ? (action.matches("button") ? action : action.querySelector("button")) : menu.querySelector("summary")
		focusTarget.focus()
	})
}

templ videoPlayer(player types.VideoPlayerProps) {
	<div id="player" class="grow overflow-hidden relative" style="min-height: 0"></div>
	<template id="feedlr-iframe-menu-icon">
		@icons.Embed()
	</template>
	<script src="/assets/js/feedlr-player.js"></script>
	@shared.EmbedScript(feedlrPlayerInit(player.Video.Channel.ID, player.Video.ID, player.Video.Progress, player.PlayerVolumeLevel, player.ReportProgress, player.Authenticated, player.SkipSegments, player.ReturnURL, shared.YouTubeString(player.Video.Title), shared.YouTubeString(player.Video.Channel.Title)), player.Video.Channel.ID, player.Video.ID, player.Video.Progress, player.PlayerVolumeLevel, player.ReportProgress, player.Authenticated, player.SkipSegments, player.ReturnURL, shared.YouTubeString(player.Video.Title), shared.YouTubeString(player.Video.Channel.Title))
}

script feedlrPlayerInit(channel, video string, progress, volume int, withProgress, authenticated bool, segments []types.SegmentProps, returnURL, title, channelTitle string) {
	const options = { channel, video, progress, volume, withProgress, authenticated, segments, returnURL, title, channelTitle }
	if (window.FeedlrPlayer) {
		window.FeedlrPlayer.mount(options)
	} else {
		// HTMX executes inline scripts while external scripts are still loading.
		window.feedlrPendingPlayer = { options, root: document.getElementById("player") }
	}
}

templ buttonChannel(id string) {
	<a href={ templ.URL(fmt.Sprintf("/channel/%s", id)) } class="ui-video-rail-btn" aria-label="Open channel">
		@icons.Profile()
	</a>
}

templ buttonShare(id string) {
	<button id="share-video-link-btn" type="button" class="ui-action-menu-item">
		@icons.Share()
		<span>Share</span>
	</button>
	@shared.EmbedScript(shareButtonScript(id), id)
}

templ buttonTV() {
	<button id="send-to-tv-btn" type="button" class="ui-action-menu-item" aria-label="Send to TV" title="Send to TV" hidden disabled>
		@icons.TV()
		<span>Send to TV</span>
	</button>
}

script shareButtonScript(id string) {
	const link = window.location.origin + "/video/" + id
	document.getElementById("share-video-link-btn").addEventListener("click", () => {
		if (!navigator.share) {
			navigator.clipboard.writeText(link);
			return
		}
		navigator.share({
			title: document.title,
			url: link
		})
	})
}

templ buttonLogin() {
	<a class="close-button ui-btn ui-btn-primary ui-btn-sm" href="/login" id="close-button">Login</a>
}

templ buttonBack(url string) {
	<a class="close-button ui-video-rail-btn bg-accent text-slate-950 hover:bg-accent-strong" href={ templ.URL(url) } id="close-button" aria-label="Close player">
		@icons.Cross()
	</a>
}

templ notificationToast(message string) {
	<div class="fixed left-1/2 bottom-4 z-40 -translate-x-1/2">
		<div class="ui-motion-toast ui-toast ui-toast-info opacity-90"><span>{ message }</span></div>
	</div>
}

package app

import (
	"github.com/cufee/feedlr-yt/internal/templates/components/subscriptions"
	"github.com/cufee/feedlr-yt/internal/templates/components/ui"
	"github.com/cufee/feedlr-yt/internal/types"
)

templ Onboarding(discovery types.MediaSource, podcastSearchAvailable bool) {
	<head><title>Welcome to Feedlr!</title></head>
	<div class="flex flex-col gap-6">
		<div class="ui-section">
			<div class="ui-section-header justify-center">
				<h2 class="ui-section-title">Build your feed</h2>
			</div>
			<p class="mx-auto max-w-xl text-center text-sm text-text-secondary">Subscribe to a YouTube channel or a podcast to start your feed.</p>
			@ui.SectionMenu("Subscription discovery source", []ui.MenuItem{
				{Label: "YouTube", Href: "/app/onboarding?discover=youtube", Active: discovery == types.MediaSourceYouTube},
				{Label: "Podcasts", Href: "/app/onboarding?discover=podcasts", Active: discovery == types.MediaSourcePodcasts},
			})
			@subscriptions.Discovery(subscriptions.DiscoveryProps{
				SubscriptionSource: discovery,
				PodcastSearchAvailable: podcastSearchAvailable,
			})
			<div id="subscriptions" class="ui-section">
				<div class="ui-channel-grid" id="subscriptions-list"></div>
			</div>
		</div>
	</div>
}

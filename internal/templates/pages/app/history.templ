package app

import (
	"github.com/cufee/feedlr-yt/internal/templates/components/feed"
	"github.com/cufee/feedlr-yt/internal/templates/components/ui"
	"github.com/cufee/feedlr-yt/internal/types"
)

templ History(props []types.VideoProps, source types.MediaSource) {
	<head>
		<title>Feedlr - Recent</title>
	</head>
	<div id="app-index" class="flex flex-col gap-4">
		@ui.SectionMenu("Recent media filter", []ui.MenuItem{
			{Label: "All", Href: "/app/recent?source=all", Active: source == types.MediaSourceAll},
			{Label: "YouTube", Href: "/app/recent?source=youtube", Active: source == types.MediaSourceYouTube},
			{Label: "Podcasts", Href: "/app/recent?source=podcasts", Active: source == types.MediaSourcePodcasts},
		})
		if len(props) == 0 {
			@ui.EmptyState("No recent items yet", "Playback history for this source will appear here", "py-10")
		}
		@feed.VideoFeed(props, "/app/recent", feed.WithChannelName, feed.WithProgressBar)
	</div>
}
